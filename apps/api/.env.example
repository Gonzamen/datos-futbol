# Postgres connection string.
# Local dev with the included docker-compose.yml (docker compose up -d):
DATABASE_URL=postgres://datos_futbol:datos_futbol@localhost:5432/datos_futbol
# For a hosted DB instead (e.g. Neon's free tier), use its connection string and
# append ?sslmode=require.

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI must be exactly GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Any long random string. Rotating it logs everybody out.
JWT_SECRET=change-me-to-a-long-random-string

# Where the browser is sent after login, and the origin CORS allows with credentials.
WEB_ORIGIN=http://localhost:5173

PORT=3001

# unset (dev) → cookies work over http://localhost. Set to "true" in production (https).
COOKIE_SECURE=false

# "lax" alcanza en desarrollo, donde web y API comparten localhost. En producción,
# con la web en Vercel y la API en Railway, son sitios distintos: hace falta "none"
# (y COOKIE_SECURE=true) o la cookie de sesión no viaja.
COOKIE_SAMESITE=lax
