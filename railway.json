{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build -w @datos-futbol/domain && npm run build -w @datos-futbol/api"
  },
  "deploy": {
    "startCommand": "npm run db:migrate:dist -w @datos-futbol/api && npm start -w @datos-futbol/api",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
